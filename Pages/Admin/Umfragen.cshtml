@page
@model Intranet2.Pages.Admin.UmfragenModel

@{
    ViewData["Title"] = "Umfragen verwalten";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">
                Umfragen verwalten
            </h1>
            <p class="text-muted">
                Umfragen für die Startseite erstellen und auswerten.
            </p>
        </div>
        @if (User.IsInRole(Rollen.Admin))
        {
            <a asp-page="/Admin/Index" class="btn btn-outline-secondary">Zurück</a>
        }
        else
        {
            <a asp-page="/Umfragen/Index" class="btn btn-outline-secondary">Zurück</a>
        }
    </div>


    @if (!string.IsNullOrWhiteSpace(Model.Meldung))
    {
        <div class="alert alert-success">
            @Model.Meldung
        </div>
    }

    <div class="card shadow-sm mb-5">
        <div class="card-body">
            <h2 class="h4 mb-4">
                @(Model.Formular.Id == 0 ? "Neue Umfrage" : "Umfrage bearbeiten")
            </h2>

            <form method="post" asp-page-handler="Speichern">

                <input type="hidden" asp-for="Formular.Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- FRAGE -->
                <div class="mb-3">
                    <label asp-for="Formular.Frage" class="form-label">
                        Frage
                    </label>

                    <input asp-for="Formular.Frage" class="form-control" placeholder="z. B. Welches Gericht soll es beim Sommerfest geben?" />

                    <span asp-validation-for="Formular.Frage" class="text-danger"></span>
                </div>

                <!-- BESCHREIBUNG -->
                <div class="mb-4">
                    <label asp-for="Formular.Beschreibung" class="form-label">
                        Beschreibung
                        <span class="text-muted">(optional)</span>
                    </label>

                    <textarea asp-for="Formular.Beschreibung" class="form-control" rows="3"></textarea>
                </div>

                <!-- NAMENTLICHE AUSWERTUNG -->
                <div class="mb-4">
                    @if (Model.BearbeitungHatStimmen)
                    {
                        <!-- Bereits abgestimmt: Einstellung gesperrt -->
                        <div class="d-flex align-items-center gap-2">
                            <input class="form-check-input m-0 flex-shrink-0" type="checkbox" checked="@Model.Formular.NamentlicheAuswertung" disabled />

                            <label class="form-check-label mb-0">
                                Antworten einsehbar machen.
                            </label>
                        </div>

                        <input type="hidden" asp-for="Formular.NamentlicheAuswertung" />

                        <div class="form-text">
                            Nach der ersten Stimme kann diese Einstellung
                            nicht mehr geändert werden.
                        </div>
                    }
                    else
                    {
                        <!-- Noch keine Stimmen: Einstellung veränderbar -->
                        <div class="d-flex align-items-center gap-2">
                            <input asp-for="Formular.NamentlicheAuswertung" class="form-check-input m-0 flex-shrink-0" />

                            <label asp-for="Formular.NamentlicheAuswertung" class="form-check-label mb-0">
                                Antworten einsehbar machen.
                            </label>
                        </div>

                        <div class="form-text">
                            Einsicht in die Antworten der Umfrage.
                        </div>
                    }

                    <span asp-validation-for="Formular.NamentlicheAuswertung" class="text-danger">
                    </span>

                </div>

                <!-- ANTWORTMÖGLICHKEITEN -->
                <div class="mb-4">
                    <label class="form-label">
                        Antwortmöglichkeiten
                    </label>

                    @if (Model.BearbeitungHatStimmen)
                    {
                        <div class="alert alert-info py-2">
                            Da bereits abgestimmt wurde,
                            können die Antwortmöglichkeiten
                            nicht mehr verändert werden.
                        </div>
                    }

                    <div id="umfrageOptionen">
                        @for (int i = 0; i < Model.Formular.Optionen.Count; i++)
                        {
                            <div class="input-group mb-2 umfrage-option-row">

                                @if (Model.BearbeitungHatStimmen)
                                {
                                    <input type="text" class="form-control" value="@Model.Formular.Optionen[i]" disabled />

                                    <input type="hidden" name="Formular.Optionen[@i]" value="@Model.Formular.Optionen[i]" />
                                }
                                else
                                {
                                    <input type="text" class="form-control umfrage-option-input" name="Formular.Optionen[@i]" value="@Model.Formular.Optionen[i]" placeholder="Antwortmöglichkeit" />

                                    <button type="button" class="btn btn-outline-danger umfrage-option-remove">
                                        Entfernen
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @if (!Model.BearbeitungHatStimmen)
                    {
                        <button type="button" id="umfrageOptionHinzufuegen" class="btn btn-outline-secondary btn-sm mt-2">
                            + Antwort hinzufügen
                        </button>
                    }

                    <span class="text-danger" asp-validation-for="Formular.Optionen"></span>
                </div>

                <div class="row">
                    <!-- START -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Formular.StartetAm" class="form-label">
                            Start
                        </label>

                        <input asp-for="Formular.StartetAm" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
                    </div>

                    <!-- ENDE -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="Formular.EndetAm" class="form-label">
                            Ende
                            <span class="text-muted">
                                (optional)
                            </span>
                        </label>

                        <input asp-for="Formular.EndetAm" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />

                        <span asp-validation-for="Formular.EndetAm" class="text-danger"></span>
                    </div>

                    <!-- AKTIV -->
                    <div class="col-md-4 mb-3">
                        <label class="form-label d-block">
                            Status
                        </label>

                        <div class="form-check mt-2">
                            <input asp-for="Formular.IstAktiv" class="form-check-input" />

                            <label asp-for="Formular.IstAktiv" class="form-check-label">
                                Aktiv
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        @(Model.Formular.Id == 0 ? "Umfrage erstellen" : "Änderungen speichern")
                    </button>

                    @if (Model.Formular.Id != 0)
                    {
                        <a asp-page="/Admin/Umfragen" class="btn btn-outline-secondary">
                            Abbrechen
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- VORHANDENE UMFRAGEN -->
    <h2 class="h3 mb-3">
        Vorhandene Umfragen
    </h2>

    <div class="card shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Frage</th>
                        <th>Zeitraum</th>
                        <th>Stimmen</th>
                        <th>Status</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Umfragen.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Noch keine Umfragen vorhanden.
                            </td>
                        </tr>
                    }

                    @foreach (var umfrage in Model.Umfragen)
                    {
                        string status;
                        string statusFarbe;

                        if (!umfrage.IstAktiv)
                        {
                            status = "Inaktiv";
                            statusFarbe = "secondary";
                        }
                        else if (umfrage.StartetAm > DateTime.Now)
                        {
                            status = "Geplant";
                            statusFarbe = "warning";
                        }
                        else if (umfrage.EndetAm.HasValue && umfrage.EndetAm.Value < DateTime.Now)
                        {
                            status = "Beendet";
                            statusFarbe = "secondary";
                        }
                        else
                        {
                            status = "Aktiv";
                            statusFarbe = "success";
                        }

                        <tr>
                            <td>
                                <strong>
                                    @umfrage.Frage
                                </strong>

                                <div class="small text-muted">
                                    @umfrage.Optionen.Count
                                    Antwortmöglichkeiten
                                </div>
                            </td>

                            <td>
                                @umfrage.StartetAm.ToString("dd.MM.yyyy HH:mm")
                                <br />
                                <span class="text-muted">
                                    @if (umfrage.EndetAm.HasValue)
                                    { @umfrage.EndetAm.Value.ToString("dd.MM.yyyy HH:mm") }
                                    else
                                    {
                                        <text>Kein Enddatum</text>
                                    }
                                </span>
                            </td>

                            <td>
                                @umfrage.Stimmen.Count
                            </td>

                            <td>
                                <span class="badge bg-@statusFarbe">
                                    @status
                                </span>
                            </td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-page="/Admin/Umfragen" asp-route-bearbeitenId="@umfrage.Id" class="btn btn-sm btn-outline-primary">
                                        Bearbeiten
                                    </a>


                                    @if (umfrage.NamentlicheAuswertung && (User.IsInRole(Rollen.Admin) || (!string.IsNullOrWhiteSpace(User.Identity?.Name) && string.Equals(User.Identity.Name, umfrage.ErstelltVon, StringComparison.OrdinalIgnoreCase))))
                                    {
                                        <a asp-page="/Umfragen/Abstimmungen" asp-route-id="@umfrage.Id" class="btn btn-sm btn-outline-secondary">
                                            Einzelstimmen
                                        </a>
                                    }

                                    <form method="post" asp-page-handler="Loeschen" onsubmit="return confirm('Diese Umfrage wirklich löschen?');">

                                        <input type="hidden" name="id" value="@umfrage.Id" />

                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Löschen
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded",
            function () {

                const container = document.getElementById("umfrageOptionen");

                const addButton = document.getElementById("umfrageOptionHinzufuegen");

                if (!container || !addButton) { return; }

                function neuNummerieren() {
                    const inputs = container.querySelectorAll( ".umfrage-option-input");

                    inputs.forEach(function (input, index) { input.name =`Formular.Optionen[${index}]`;});
                }


                function removeEvents() {

                    container.querySelectorAll(".umfrage-option-remove").forEach(function (button) 
                    {
                        button.onclick = function () 
                        {
                           const rows = container.querySelectorAll(".umfrage-option-row");
                           
                           if (rows.length <= 2) {
                               return;
                           }
                           
                           button.closest(".umfrage-option-row").remove();
                           neuNummerieren();
                        };
                    });
                }

                addButton.addEventListener("click", function () {

                        const index = container.querySelectorAll(".umfrage-option-row").length

                        const row = document.createElement("div");

                        row.className =  "input-group mb-2 umfrage-option-row";

                        row.innerHTML =`<input type="text" class="form-control umfrage-option-input" name="Formular.Optionen[${index}]" placeholder="Antwortmöglichkeit" />

                            <button type="button" class="btn btn-outline-danger umfrage-option-remove">
                                Entfernen
                            </button>`;

                        container.appendChild(row);
                        removeEvents();
                    });
                removeEvents();
            });
    </script>
}