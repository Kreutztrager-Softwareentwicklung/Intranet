@page
@model Intranet2.Pages.Ansprechpartner.UnterabteilungModel

@{
    ViewData["Title"] = Model.DirekteAbteilungsansicht ? Model.Abteilung : Model.Unterabteilung;
}

<div class="container py-4">
    <!-- ZURÜCK -->
    <div class="mb-4">
        @if (Model.DirekteAbteilungsansicht)
        {
            <a asp-page="/Ansprechpartner/Abteilungen" class="text-decoration-none">
                ← Zurück zu Abteilungen
            </a>
        }
        else
        {
            <a asp-page="/Ansprechpartner/Abteilung" asp-route-abteilung="@Model.Abteilung" class="text-decoration-none">
                ← Zurück zu @Model.Abteilung
            </a>
        }
    </div>

    <!-- ÜBERSCHRIFT -->
    <div class="mb-4">
        @if (Model.DirekteAbteilungsansicht)
        {
            <h1 class="fw-bold mb-1" style="color: var(--kt-dunkelblau);">
                @Model.Abteilung
            </h1>

            <p class="text-muted mb-0">
                @Model.Mitarbeiter.Count Mitarbeiter
            </p>
        }
        else
        {
            <div class="text-muted mb-1">
                @Model.Abteilung
            </div>

            <h1 class="fw-bold mb-1" style="color: var(--kt-dunkelblau);">
                @Model.Unterabteilung
            </h1>

            <p class="text-muted mb-0">
                @Model.Mitarbeiter.Count Mitarbeiter
            </p>
        }
    </div>

    <!-- KEINE MITARBEITER -->
    @if (Model.Mitarbeiter.Count == 0)
    {
        <div class="alert alert-warning">
            Es wurden keine Mitarbeiter
            im Active Directory gefunden.
        </div>
    }
    else
    {
        <!-- MITARBEITER -->
        <div class="row g-4">
            @foreach (var mitarbeiter in Model.Mitarbeiter)
            {
                string? fotoUrl = Model.GetFotoUrl(mitarbeiter);

                bool istGesuchtePerson = !string.IsNullOrWhiteSpace(Model.HervorgehobenerBenutzername)
                && string.Equals(mitarbeiter.SamAccountName, Model.HervorgehobenerBenutzername, StringComparison.OrdinalIgnoreCase);

                <div class="col-xl-4 col-lg-6 col-md-6 @(istGesuchtePerson ? "ansprechpartner-gesucht" : "")" id="@(istGesuchtePerson ? "gesuchte-person" : null)">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <!-- FOTO -->
                            <div class="text-center mb-3">
                                @if (!string.IsNullOrWhiteSpace(fotoUrl))
                                {
                                    <img src="@fotoUrl" alt="@mitarbeiter.Anzeigename" class="rounded-circle" style="width: 90px; height: 90px; object-fit: cover; object-position: top;" />
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto" style="width: 90px; height: 90px;">

                                        <span class="text-white fw-bold fs-4">
                                            @Model.GetInitial(mitarbeiter)
                                        </span>
                                    </div>
                                }
                            </div>

                            <div class="text-center">
                                <!-- NAME -->
                                <h2 class="h5 fw-bold mb-1" style="color: var(--kt-dunkelblau);">
                                    @mitarbeiter.Anzeigename
                                </h2>


                                <!-- LEITUNG DER AKTUELLEN UNTERABTEILUNG -->
                                @if (!Model.DirekteAbteilungsansicht && mitarbeiter.IstLeitungInUnterabteilung(Model.Unterabteilung))
                                {
                                    <div class="mb-2">
                                        <span class="badge bg-primary">
                                            Leitung
                                        </span>
                                    </div>
                                }

                                <!-- POSITION -->
                                @if (!string.IsNullOrWhiteSpace(mitarbeiter.Title))
                                {
                                    <div class="text-primary fw-semibold mb-1">
                                        @mitarbeiter.Title
                                    </div>
                                }

                                <!-- HAUPTABTEILUNG -->
                                @if (!string.IsNullOrWhiteSpace(mitarbeiter.Department))
                                {
                                    <div class="text-muted">
                                        @mitarbeiter.Department
                                    </div>
                                }

                            </div>

                            <hr />

                            <!-- TELEFON -->
                            @if (!string.IsNullOrWhiteSpace(mitarbeiter.TelephoneNumber))
                            {
                                <div class="mb-2">
                                    <strong>
                                        Telefon:
                                    </strong>

                                    <br />

                                    <a href="tel:@mitarbeiter.TelephoneNumber" class="text-decoration-none">
                                        @mitarbeiter.TelephoneNumber
                                    </a>

                                </div>
                            }

                            <!-- MOBIL -->
                            @if (!string.IsNullOrWhiteSpace(mitarbeiter.Mobile))
                            {
                                <div class="mb-2">
                                    <strong>
                                        Mobil:
                                    </strong>

                                    <br />

                                    <a href="tel:@mitarbeiter.Mobile" class="text-decoration-none">
                                        @mitarbeiter.Mobile
                                    </a>
                                </div>
                            }

                            <!-- E-MAIL -->
                            @if (!string.IsNullOrWhiteSpace(mitarbeiter.Email))
                            {
                                <div class="mb-2">
                                    <strong>
                                        E-Mail:
                                    </strong>

                                    <br />

                                    <a href="mailto:@mitarbeiter.Email" class="text-decoration-none">
                                        @mitarbeiter.Email
                                    </a>
                                </div>
                            }

                            <!-- STANDORT -->
                            @if (!string.IsNullOrWhiteSpace(mitarbeiter.StreetAddress) || !string.IsNullOrWhiteSpace(mitarbeiter.City))
                            {
                                <div class="mt-3">
                                    <strong>
                                        Standort:
                                    </strong>

                                    <br />

                                    @if (!string.IsNullOrWhiteSpace(mitarbeiter.StreetAddress))
                                    {
                                        <span class="text-muted">
                                            @mitarbeiter.StreetAddress
                                        </span>

                                        <br />
                                    }

                                    <span class="text-muted">
                                        @mitarbeiter.PostalCode
                                        @mitarbeiter.City
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const gesuchtePerson =
            document.getElementById("gesuchte-person");

        if (!gesuchtePerson) {
            return;
        }

        setTimeout(function () {

            gesuchtePerson.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });

        }, 150);

    });
</script>