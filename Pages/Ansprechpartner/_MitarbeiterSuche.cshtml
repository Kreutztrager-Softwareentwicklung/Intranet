@{
    string aktuelleSeite = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    bool istAbteilungsSuche = aktuelleSeite.EndsWith(
        "/Abteilungen", StringComparison.OrdinalIgnoreCase);
    string modus = istAbteilungsSuche ? "abteilung" : "standort";
}

<div class="mitarbeiter-suche">
    <div class="mitarbeiter-suche-header">
        <label for="mitarbeiterSuchfeld" class="mitarbeiter-suche-label">
            Mitarbeiter suchen
        </label>
        <p class="mitarbeiter-suche-hinweis">
            Suche nach Vor- oder Nachname.
        </p>
    </div>

    <div class="mitarbeiter-suche-input-wrapper">
        <span class="mitarbeiter-suche-icon" aria-hidden="true">🔍</span>
        <input id="mitarbeiterSuchfeld"
               type="search"
               class="form-control mitarbeiter-suche-input"
               placeholder="z. B. Jan-Peter Nissen"
               autocomplete="off"
               aria-label="Mitarbeiter suchen"
               data-modus="@modus" />
    </div>

    <div id="mitarbeiterSuchErgebnis" class="mitarbeiter-suche-ergebnisse" hidden>
        <!-- Wird per JavaScript befüllt -->
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const suchfeld          = document.getElementById("mitarbeiterSuchfeld");
        const ergebnisContainer = document.getElementById("mitarbeiterSuchErgebnis");
        const modus             = suchfeld?.dataset.modus ?? "standort";

            // =====================================================
            // KOMPLETTE MITARBEITERKARTE ANKLICKBAR MACHEN
            // =====================================================

            ergebnisContainer.addEventListener("click", function (event) {

                // Wenn auf Telefon, Mobil, E-Mail oder den
                // vorhandenen Button geklickt wurde:
                // normale Link-Funktion beibehalten.
                if (event.target.closest("a")) {
                    return;
                }

                // Angeklickte Mitarbeiterkarte ermitteln
                const karte = event.target.closest(".mitarbeiter-suche-person");
                    if (!karte) {
                        return;
                    }

                // Vorhandenen "Zur Person"-Link ermitteln
                const ziel = karte.querySelector(".mitarbeiter-suche-aktion a[href]");

                if (!ziel) {
                    return;
                }

                // Zur Mitarbeiterseite navigieren
                window.location.assign(ziel.href);

            });

        if (!suchfeld || !ergebnisContainer) return;

        let debounceTimer = null;

        suchfeld.addEventListener("input", function () {
            clearTimeout(debounceTimer);
            const suchbegriff = suchfeld.value.trim();

            if (suchbegriff.length < 2) {
                ergebnisContainer.hidden = true;
                ergebnisContainer.innerHTML = "";
                return;
            }

            // 300ms warten bevor API aufgerufen wird (Debounce)
            debounceTimer = setTimeout(function () {
                fetch(`/Ansprechpartner/MitarbeiterSucheApi?q=${encodeURIComponent(suchbegriff)}&modus=${modus}`)
                    .then(r => r.json())
                    .then(mitarbeiter => {
                        ergebnisContainer.innerHTML = "";

                        if (mitarbeiter.length === 0) {
                            ergebnisContainer.innerHTML =
                                '<div class="mitarbeiter-suche-leer">Kein Mitarbeiter gefunden.</div>';
                            ergebnisContainer.hidden = false;
                            return;
                        }

                        mitarbeiter.forEach(function (m) {
                            const istGF = m.department === "Geschäftsführung" ||
                                          m.department === "Geschaeftsfuehrung";

                            // Link je nach Modus
                            let linkHref = "#";
                            if (modus === "abteilung") {
                                if (istGF) {
                                    linkHref = `/Ansprechpartner/Unterabteilung?abteilung=${encodeURIComponent(m.department)}&person=${encodeURIComponent(m.samAccountName)}&direkt=true`;
                                } else if (m.department && m.unterabteilung) {
                                    linkHref = `/Ansprechpartner/Unterabteilung?abteilung=${encodeURIComponent(m.department)}&unterabteilung=${encodeURIComponent(m.unterabteilung)}&person=${encodeURIComponent(m.samAccountName)}`;
                                } else if (m.department) {
                                    linkHref = `/Ansprechpartner/Abteilung?abteilung=${encodeURIComponent(m.department)}`;
                                }
                            } else {
                                if (m.niederlassung) {
                                    linkHref = `/Ansprechpartner/Standort?niederlassung=${encodeURIComponent(m.niederlassung)}&person=${encodeURIComponent(m.samAccountName)}`;
                                }
                            }

                            const leitungBadge = m.istLeitung
                                ? '<span class="mitarbeiter-suche-leitung">Leitung</span>' : "";
                            const telefon = m.telefon
                                ? `<a href="tel:${m.telefon}" class="mitarbeiter-suche-kontakt-link">Tel. ${m.telefon}</a>` : "";
                            const mobil = m.mobil
                                ? `<a href="tel:${m.mobil}" class="mitarbeiter-suche-kontakt-link">Mobil ${m.mobil}</a>` : "";
                            const email = m.email
                                ? `<a href="mailto:${m.email}" class="mitarbeiter-suche-kontakt-link">E-Mail</a>` : "";

                            const meta = [m.department, m.unterabteilung, m.niederlassung]
                                .filter(Boolean).join(" · ");

                            ergebnisContainer.innerHTML += `
                                <div class="mitarbeiter-suche-eintrag">
                                    <div class="mitarbeiter-suche-person">
                                        <div class="mitarbeiter-suche-avatar">${m.initial}</div>
                                        <div class="mitarbeiter-suche-person-info">
                                            <div class="mitarbeiter-suche-name">
                                                ${m.anzeigename} ${leitungBadge}
                                            </div>
                                            ${m.title ? `<div class="mitarbeiter-suche-position">${m.title}</div>` : ""}
                                            <div class="mitarbeiter-suche-meta">${meta}</div>
                                            <div class="mitarbeiter-suche-kontakt">
                                                ${telefon}${mobil}${email}
                                            </div>
                                        </div>
                                        <div class="mitarbeiter-suche-aktion">
                                            <a href="${linkHref}" class="btn btn-sm btn-outline-primary">
                                                Zur Person →
                                            </a>
                                        </div>
                                    </div>
                                </div>`;
                        });

                        ergebnisContainer.hidden = false;
                    })
                    .catch(function () {
                        ergebnisContainer.innerHTML =
                            '<div class="mitarbeiter-suche-leer">Suche nicht verfügbar.</div>';
                        ergebnisContainer.hidden = false;
                    });
            }, 300);
        });

        suchfeld.addEventListener("keydown", function (e) {
            if (e.key === "Escape") {
                suchfeld.value = "";
                ergebnisContainer.hidden = true;
                ergebnisContainer.innerHTML = "";
            }
        });
    });
</script>
