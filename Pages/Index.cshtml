@page
@model Intranet2.Pages.IndexModel

@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid home-page">
    <div class="row g-4">

        <!-- LINKE SEITE: GROSSE NEWS -->
        <div class="col-xl-8 col-lg-8">

            <div class="home-section-header">
                <div>
                    <h1 class="mb-1">
                        Aktuelle News
                    </h1>

                    <p class="text-muted mb-0">
                        Neuigkeiten aus dem Unternehmen
                    </p>
                </div>

                <a asp-page="/News/Index" class="btn btn-outline-primary">
                    Alle News
                </a>
            </div>

            @if (Model.NewsItems.Count == 0)
            {
                <div class="alert alert-info mt-4">
                    Zurzeit gibt es keine aktuellen News.
                </div>
            }
            else
            {
                <div class="home-news-list">
                    @foreach (var news in Model.NewsItems)
                    {
                        <article class="home-news-card">

                            @if (!string.IsNullOrWhiteSpace(news.BildPfad))
                            {
                                <a asp-page="/News/Details" asp-route-id="@news.Id" class="home-news-image-link">
                                    <img src="@Url.Content(news.BildPfad)" alt="@news.Titel" class="home-news-image" />
                                </a>
                            }

                            <div class="home-news-content">

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-@news.KategorieFarbe">
                                        @news.Kategorie
                                    </span>

                                    <span class="text-muted small">
                                        @news.VeroeffentlichtAm.ToString("dd.MM.yyyy")
                                    </span>
                                </div>

                                <h2 class="home-news-title">
                                    <a asp-page="/News/Details" asp-route-id="@news.Id">
                                        @news.Titel
                                    </a>
                                </h2>

                                <p class="home-news-text">
                                    @news.Kurztext
                                </p>

                                <a asp-page="/News/Details" asp-route-id="@news.Id" class="home-news-more">
                                    Weiterlesen →
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <!-- RECHTE SEITE: KLEINER FEED -->
        <div class="col-xl-4 col-lg-4">
            <div class="home-side-feed">
                <div class="home-side-feed-header">
                    <div>
                        <h2 class="h5 mb-1">
                            Aktuelles
                        </h2>

                        <span>
                            Meldungen und Umfragen
                        </span>
                    </div>
                </div>

                <!-- GEMEINSAMER FEED - KURZMELDUNGEN UND UMFRAGEN -->
                <div class="home-side-feed-body">
                    <!-- MELDUNG NACH EINER ABSTIMMUNG -->
                    @if (!string.IsNullOrWhiteSpace(Model.UmfrageMeldung))
                    {
                        <div class="home-poll-message">
                            @Model.UmfrageMeldung
                        </div>
                    }

                    <!-- KEINE FEED-EINTRÄGE -->
                    @if (Model.FeedEintraege.Count == 0)
                    {
                        <div class="home-feed-empty">
                            Aktuell gibt es keine Meldungen oder Umfragen.
                        </div>
                    }
                    else
                    {
                        <!-- GEMEINSAME CHRONOLOGISCHE AUSGABE -->
                        @foreach (var eintrag in Model.FeedEintraege)
                        {
                            <!-- UMFRAGE -->
                            @if (eintrag.Umfrage != null)
                            {
                                var umfrage = eintrag.Umfrage;

                                int gesamtStimmen = eintrag.GesamtStimmen;

                                int? eigeneOptionId = eintrag.EigeneOptionId;

                                <div class="home-poll">
                                    <!-- UMFRAGE-LABEL -->
                                    <div class="home-poll-label">
                                        Umfrage
                                    </div>

                                    <!-- ANKLICKBARER UMFRAGETITEL -->
                                    <h3 class="home-poll-title">
                                        <a asp-page="/Umfragen/Index" class="home-poll-link">
                                            @umfrage.Frage
                                        </a>
                                    </h3>

                                    <!-- ERSTELLER -->
                                    <div class="home-poll-ersteller text-muted small mb-2">
                                        Erstellt von:
                                        <strong>
                                            @eintrag.ErstellerName
                                        </strong>
                                    </div>

                                    <!-- BESCHREIBUNG -->
                                    @if (!string.IsNullOrWhiteSpace(umfrage.Beschreibung))
                                    {
                                        <p class="home-poll-description">
                                            @umfrage.Beschreibung
                                        </p>
                                    }

                                    <!-- NOCH NICHT ABGESTIMMT -->
                                    @if (!eigeneOptionId.HasValue)
                                    {
                                        <form method="post" asp-page-handler="Abstimmen">
                                            <input type="hidden" name="umfrageId" value="@umfrage.Id" />

                                            <div class="home-poll-options">
                                                @foreach (var option in umfrage.Optionen.OrderBy(o => o.Sortierung))
                                                {
                                                    <label class="home-poll-option">
                                                        <input type="radio" name="optionId" value="@option.Id" required />
                                                        <span>
                                                            @option.Text
                                                        </span>
                                                    </label>
                                                }
                                            </div>

                                            <button type="submit" class="btn btn-primary btn-sm w-100 mt-3">
                                                Abstimmen
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <!-- BEREITS ABGESTIMMT - ERGEBNISSE -->
                                        <div class="home-poll-results">
                                            @foreach (var option in umfrage.Optionen.OrderBy(o => o.Sortierung))
                                            {
                                                int stimmen = option.Stimmen.Count;

                                                int prozent = gesamtStimmen == 0 ? 0 : (int)Math.Round(stimmen * 100.0 / gesamtStimmen);

                                                bool eigeneAntwort = eigeneOptionId == option.Id;

                                                <div class="home-poll-result">
                                                    <div class="home-poll-result-header">
                                                        <span>
                                                            @option.Text

                                                            @if (eigeneAntwort)
                                                            {
                                                                <strong>
                                                                    ✓
                                                                </strong>
                                                            }
                                                        </span>

                                                        <span>
                                                            @prozent %
                                                        </span>
                                                    </div>


                                                    <div class="home-poll-progress">
                                                        <div class="home-poll-progress-bar" style="@($"width: {prozent}%;")"> </div>
                                                    </div>
                                                </div>
                                            } 
                                            
                                            <!-- GESAMTSTIMMEN --> 
                                            <div class="home-poll-total"> 
                                                @gesamtStimmen 
                                                @(gesamtStimmen == 1 ? "Stimme" : "Stimmen") 
                                            </div> 
                                        </div> 
                                    } 
                                </div> 
                            } 
                            else if (eintrag.Kurzmeldung != null) 
                            { 
                                var meldung = eintrag.Kurzmeldung; 
                                
                                <a asp-page="/News/Details" asp-route-id="@meldung.Id" class="home-feed-item"> 
                                    <!-- KATEGORIE UND DATUM --> 
                                    <div class="home-feed-meta"> 
                                        <span class="badge bg-@meldung.KategorieFarbe"> 
                                            @meldung.Kategorie 
                                        </span> 

                                        <span> 
                                            @meldung.VeroeffentlichtAm.ToString("dd.MM.") 
                                        </span> 
                                    </div> 
                                    
                                    <!-- TITEL --> 
                                    <div class="home-feed-title"> 
                                        @meldung.Titel 
                                    </div> 
                                    
                                    <!-- KURZTEXT --> 
                                    @if (!string.IsNullOrWhiteSpace(meldung.Kurztext)) 
                                    { 
                                        <div class="home-feed-text"> 
                                            @meldung.Kurztext 
                                        </div> 
                                    } 
                                </a> 
                            } 
                        } 
                    } 
                </div> 
            </div> 
        </div> 
    </div> 
</div>