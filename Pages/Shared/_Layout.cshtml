@inject Intranet2.Services.ActiveDirectory.MitarbeiterService MitarbeiterService
<!DOCTYPE html>
<html lang="en">

@{
    int neueMarktplatzBeitraege = Context.Items["NeueMarktplatzBeitraege"] is int anzahl ? anzahl : 0;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Intranet</title> <!--Tab title-->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Intranet2.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/Images/kt-logo-favicon-apple.jpg"> <!--Kleines Logo im Tab-->
    <link rel="icon" type="image/png" sizes="16x16" href="~/Images/kt-logo-favicon-apple.jpg"> <!--Kleines Logo im Tab-->
</head>

<body>
    <header>
        <div class="kt-topbar">
            <div class="kt-topbar-inner">
                <!-- LINKS: KREUTZTRÄGER-LOGO -->
                <div class="kt-topbar-left">
                    <a asp-page="/Index" class="kt-logo-link">
                        <img src="~/Images/LogoKKT.png" alt="Kreutzträger Kältetechnik" class="kt-topbar-logo" />
                    </a>
                </div>

                <!-- RECHTS: ANGEMELDETER MITARBEITER -->
                <div class="kt-topbar-right">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        string windowsName = User.Identity.Name ?? string.Empty;

                        var mitarbeiter = MitarbeiterService.GetMitarbeiterFuerBenutzername(windowsName);

                        string anzeigename;

                        if (mitarbeiter != null)
                        {
                            string vorname = mitarbeiter.FirstName?.Trim() ?? string.Empty;

                            string nachname = mitarbeiter.LastName?.Trim() ?? string.Empty;

                            anzeigename = $"{vorname} {nachname}".Trim();

                            if (string.IsNullOrWhiteSpace(anzeigename))
                            {
                                anzeigename = mitarbeiter.DisplayName;
                            }
                        }
                        else
                        {
                            anzeigename = windowsName.Contains("\\") ? windowsName.Split('\\').Last() : windowsName;
                        }

                        <div class="kt-user-area">
                            <span class="kt-user-name">
                                Hallo @anzeigename!
                            </span>
                        </div>
                    }

                </div>
            </div>
        </div>

