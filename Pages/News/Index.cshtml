@page
@model Intranet2.Pages.News.IndexModel

@{
    ViewData["Title"] = "Neuigkeiten";
}


<div class="container py-4">

    <!-- KOPFBEREICH -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Mitarbeiter-News
        </h1>

        <p class="text-muted">
            Aktuelle Nachrichten und Informationen aus dem Unternehmen.
        </p>
        
        <!-- SUCHE UND FILTER -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <form method="get">
                    <div class="row g-3 align-items-end">

                        <!-- SUCHE -->
                        <div class="col-lg-6">
                            <label asp-for="Suche" class="form-label">
                                Suche
                            </label>

                            <input asp-for="Suche" class="form-control" placeholder="Titel oder Kurztext durchsuchen..." />
                        </div>

                        <!-- KATEGORIE -->
                        <div class="col-lg-3">
                            <label asp-for="Kategorie" class="form-label">
                                Kategorie
                            </label>

                            <select asp-for="Kategorie" class="form-select">
                                <option value="">
                                    Alle Kategorien
                                </option>

                                @foreach (var kategorie in Model.Kategorien)
                                {
                                    <option value="@kategorie.Key">
                                        @kategorie.Key
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- BUTTONS -->
                        <div class="col-lg-3">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    Suchen
                                </button>

                                <a asp-page="/News/Index" class="btn btn-outline-secondary">
                                    Zurücksetzen
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>


        <div class="mb-3 text-muted">
            @Model.NewsListe.Count

            @if (Model.NewsListe.Count == 1)
            {
                <text>Beitrag gefunden</text>
            }
            else
            {
                <text>Beiträge gefunden</text>
            }
        </div>
    </div>

    @if (Model.NewsListe.Count == 0)
    {
        <div class="alert alert-info">
            Zurzeit gibt es keine Neuigkeiten.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var news in Model.NewsListe)
            {
                <div class="col-xl-4 col-lg-6 col-md-6">

                    <div class="card h-100 shadow-sm">

                        <!-- BILD -->
                        @if (!string.IsNullOrWhiteSpace(news.BildPfad))
                        {
                            <img src="@Url.Content(news.BildPfad)" class="card-img-top" alt="@news.Titel" style="height: 220px; object-fit: cover;" />
                        }

                        <div class="card-body d-flex flex-column">

                            <!-- KATEGORIE + DATUM -->
                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="badge bg-@news.KategorieFarbe">
                                    @news.Kategorie
                                </span>

                                <small class="text-muted">
                                    @news.VeroeffentlichtAm.ToString("dd.MM.yyyy")
                                </small>
                            </div>

                            <!-- TITEL -->
                            <h2 class="h5 fw-bold">
                                @news.Titel
                            </h2>

                            <!-- KURZTEXT -->
                            <p class="text-muted">
                                @news.Kurztext
                            </p>

                            <!-- BUTTON -->
                            <div class="mt-auto">

                                <a asp-page="/News/Details" asp-route-id="@news.Id" class="btn btn-outline-primary">
                                    Weiterlesen
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>